<Window x:Class="MiLauncher.launcher.ui.ConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Console - MiLauncher" Height="450" Width="800" Background="#1E1E1E">
    <Grid>
        <RichTextBox Name="ConsoleOutput" Background="#1E1E1E" Foreground="#CCCCCC" FontFamily="Consolas" FontSize="12" IsReadOnly="True" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="10">
            <FlowDocument>
                <Paragraph Name="LogParagraph" LineHeight="1"/>
            </FlowDocument>
        </RichTextBox>
    </Grid>
</Window>
