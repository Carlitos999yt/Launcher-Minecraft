<Window x:Class="MiLauncher.launcher.ui.Dialogs.SkinsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Gestor de Skins" Height="400" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Personalizar Mi Skin" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
            <TextBlock Text="Selecciona un archivo .png para aplicar tu skin localmente. El mod se encargará de enviarlo al servidor." TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,20"/>
            
            <Button x:Name="SelectSkinButton" Content="SELECCIONAR ARCHIVO .PNG" Style="{DynamicResource MaterialDesignOutlinedButton}" Click="SelectSkinButton_Click" Margin="0,0,0,20"/>
            
            <TextBlock x:Name="SelectedFileText" Text="Ningún archivo seleccionado" FontStyle="Italic" Opacity="0.5" Margin="0,0,0,20" HorizontalAlignment="Center"/>
            
            <Button x:Name="SaveSkinButton" Content="GUARDAR Y APLICAR" IsEnabled="False" Style="{DynamicResource MaterialDesignRaisedButton}" Click="SaveSkinButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
