<UserControl x:Class="MiLauncher.launcher.ui.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="INICIO" FontSize="40" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
            <TextBlock Text="Selecciona un Modpack en el menú de la derecha para ver los detalles y jugar." 
                       FontSize="16" Foreground="#AAAAAA" HorizontalAlignment="Center" Margin="0,10,0,0"/>

            <Button Command="{Binding ImportMrPackCommand}" 
                    Content="Importar Modpack de Modrinth (.mrpack)" 
                    Style="{StaticResource PremiumButton}"
                    Background="#3C8527" Foreground="White" 
                    Padding="15,10" Margin="0,30,0,0" Width="300"
                    IsEnabled="{Binding IsNotImporting, FallbackValue=True}"/>

            <TextBlock Text="{Binding ImportProgressMessage}" 
                       Foreground="#FFD700" FontSize="14" HorizontalAlignment="Center" 
                       Margin="0,15,0,0" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</UserControl>
