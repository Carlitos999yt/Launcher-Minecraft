<UserControl x:Class="MiLauncher.launcher.ui.ModpackDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="Transparent">
    <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="MainScroll_PreviewMouseWheel">
        <StackPanel>
            <!-- Cabecera estilo Launcher (Cover) -->
            <Grid Height="550">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#2A2A2A" Offset="0"/>
                        <GradientStop Color="#111111" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <Image Source="{Binding BackgroundImagePath}" Stretch="UniformToFill" IsHitTestVisible="False"/>
                <Rectangle Fill="#88000000" />

                <Grid Margin="40">
                    <!-- Título -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0" Visibility="{Binding TitleVisibility}">
                        <TextBlock Text="{Binding CustomTitle}" FontSize="{Binding TitleFontSize}" FontWeight="Bold" Foreground="{Binding TitleColorBrush}" FontFamily="{Binding TitleFontFamily}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="800">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="0" Color="Black" Direction="315" ShadowDepth="4"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>

                    <!-- Zona Inferior de la cabecera -->
                    <Grid VerticalAlignment="Bottom" Margin="0,0,0,10">
                        <!-- Versión esquinada a la izquierda -->
                        <TextBlock Text="{Binding LoaderText}" Visibility="{Binding LoaderVisibility}" FontSize="14" Foreground="#66FFFFFF" FontFamily="Arial" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>

                        <!-- Botones Centrales Perfectamente Alineados -->
                        <StackPanel HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="{Binding PlayButtonText}" Width="260" Height="50" Command="{Binding PlayCommand}"
                                        Style="{DynamicResource MaterialDesignFlatLightBgButton}" Background="{Binding PlayButtonColor}" Foreground="White" FontSize="24" FontFamily="pack://application:,,,/Resources/Fonts/MinecraftTen.ttf#Minecraft Ten" FontWeight="Bold" BorderBrush="#1F4713" BorderThickness="0,0,0,4" Cursor="Hand"/>
                                
                                <Button Width="50" Height="50" Margin="10,0,0,0" Command="{Binding OpenSettingsCommand}" Style="{DynamicResource MaterialDesignFlatLightBgButton}" Background="{DynamicResource PanelBrush}" Foreground="White" BorderBrush="#111111" BorderThickness="0,0,0,4" Cursor="Hand">
                                    <materialDesign:PackIcon Kind="DotsVertical" Width="25" Height="25" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                            
                            <!-- Barra de progreso de descarga -->
                            <StackPanel Margin="0,15,0,0">
                                <ProgressBar Value="{Binding PlayButtonProgress}" Height="6" Background="#222222" Foreground="#3C8527" BorderThickness="0" Maximum="100"/>
                                <TextBlock Text="{Binding PlayButtonStatusText}" Foreground="#AAAAAA" FontSize="12" Margin="0,5,0,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Apartado informativo debajo de la imagen -->
            <StackPanel Margin="40">
                <TextBlock Text="{Binding CustomDescription}" Visibility="{Binding DescriptionVisibility}" FontSize="15" Foreground="#CCCCCC" FontFamily="Arial" TextWrapping="Wrap" Margin="0,0,0,30" LineHeight="22"/>
                
                <TextBlock Text="Imágenes" FontSize="26" FontWeight="Bold" Foreground="White" FontFamily="Arial" Margin="0,0,0,10">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="0" Color="Black" Direction="315" ShadowDepth="2"/>
                    </TextBlock.Effect>
                </TextBlock>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="ImagesScroll_PreviewMouseWheel">
                    <StackPanel Orientation="Horizontal">
                        <!-- Placeholders de imágenes del modpack -->
                        <Border Width="300" Height="170" Background="{DynamicResource PanelBrush}" CornerRadius="8" Margin="0,0,20,0">
                            <materialDesign:PackIcon Kind="ImageOutline" Width="50" Height="50" Foreground="#555555" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Width="300" Height="170" Background="{DynamicResource PanelBrush}" CornerRadius="8" Margin="0,0,20,0">
                            <materialDesign:PackIcon Kind="ImageOutline" Width="50" Height="50" Foreground="#555555" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
