<Window x:Class="MiLauncher.launcher.ui.ModpackSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:instance="clr-namespace:MiLauncher.launcher.ui.pages.instance"
        Title="Ajustes de la Instancia" Height="600" Width="900"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <!-- Ajustes de Instancia -->
        <DataTemplate DataType="{x:Type instance:InstanceSettingsPageViewModel}">
            <StackPanel Margin="20">
                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextBrush}" Opacity="0.65" Margin="0,0,0,15" FontSize="13"/>

                <CheckBox Content="Usar Configuración Global del Launcher" IsChecked="{Binding UseGlobalSettings}" Foreground="{DynamicResource TextBrush}" FontSize="14" Margin="0,0,0,15"/>

                <StackPanel IsEnabled="{Binding IsLocalSettingsEnabled}">
                    <!-- Java Executable -->
                    <TextBlock Text="Ruta de Instalación Java" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="Bold" Margin="0,10,0,6"/>
                    <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="1" SnapsToDevicePixels="True" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding JavaPath}" Foreground="{DynamicResource TextBrush}" Background="Transparent" BorderThickness="0" Padding="10,8" VerticalContentAlignment="Center" FontSize="13"/>
                            
                            <Border Grid.Column="1" Width="1" Background="{DynamicResource BorderBrush}" Margin="0,4"/>
                            <Button Grid.Column="2" Command="{Binding AutoDetectCommand}" Background="Transparent" BorderThickness="0" Padding="10,0" Height="32" Cursor="Hand" ToolTip="Auto-detectar Java en el sistema">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="btnBorder" Background="Transparent" CornerRadius="0" Padding="8,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="AutoFix" Width="16" Height="16" Foreground="{DynamicResource TextBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Auto-detectar" Foreground="{DynamicResource TextBrush}" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="#33FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            
                            <Border Grid.Column="3" Width="1" Background="{DynamicResource BorderBrush}" Margin="0,4"/>
                            <Button Grid.Column="4" Command="{Binding BrowseJavaCommand}" Background="Transparent" BorderThickness="0" Width="36" Height="32" Padding="0" Cursor="Hand" ToolTip="Buscar java.exe / javaw.exe">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="btnBorder" Background="Transparent" CornerRadius="0">
                                            <materialDesign:PackIcon Kind="FileSearchOutline" Width="18" Height="18" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="#33FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            
                            <Border Grid.Column="5" Width="1" Background="{DynamicResource BorderBrush}" Margin="0,4"/>
                            <Button Grid.Column="6" Command="{Binding OpenJavaFolderCommand}" Background="Transparent" BorderThickness="0" Width="36" Height="32" Padding="0" Cursor="Hand" ToolTip="Abrir Carpeta Contenedora">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="btnBorder" Background="Transparent" CornerRadius="0,5,5,0">
                                            <materialDesign:PackIcon Kind="FolderOpenOutline" Width="18" Height="18" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="#33FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Memory Settings -->
                    <TextBlock Text="Asignación de Memoria" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="Bold" Margin="0,10,0,6"/>
                    
                    <TextBlock Text="Memoria Mínima (MB)" Foreground="{DynamicResource TextBrush}" Opacity="0.8" FontSize="12" Margin="0,5,0,4"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="512" Maximum="{Binding MaxMem}" Value="{Binding MinMem}" TickFrequency="512" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <Border Grid.Column="1" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="1">
                            <TextBox Text="{Binding MinMem}" Foreground="{DynamicResource TextBrush}" Background="Transparent" BorderThickness="0" Padding="8,4" Width="70" TextAlignment="Center" VerticalAlignment="Center" FontSize="13"/>
                        </Border>
                    </Grid>

                    <TextBlock Text="Memoria Máxima (MB)" Foreground="{DynamicResource TextBrush}" Opacity="0.8" FontSize="12" Margin="0,5,0,4"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="1024" Maximum="16384" Value="{Binding MaxMem}" TickFrequency="1024" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <Border Grid.Column="1" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="1">
                            <TextBox Text="{Binding MaxMem}" Foreground="{DynamicResource TextBrush}" Background="Transparent" BorderThickness="0" Padding="8,4" Width="70" TextAlignment="Center" VerticalAlignment="Center" FontSize="13"/>
                        </Border>
                    </Grid>

                    <TextBlock Text="PermGen (MB) [Solo para Java 7 o anterior]" Foreground="{DynamicResource TextBrush}" Opacity="0.8" FontSize="12" Margin="0,5,0,4"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="64" Maximum="512" Value="{Binding PermGen}" TickFrequency="64" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <Border Grid.Column="1" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="1">
                            <TextBox Text="{Binding PermGen}" Foreground="{DynamicResource TextBrush}" Background="Transparent" BorderThickness="0" Padding="8,4" Width="70" TextAlignment="Center" VerticalAlignment="Center" FontSize="13"/>
                        </Border>
                    </Grid>

                    <!-- Game Window -->
                    <TextBlock Text="Ventana del Juego" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="Bold" Margin="0,10,0,6"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Ancho (px)" Foreground="{DynamicResource TextBrush}" Opacity="0.65" FontSize="11" Margin="0,0,0,4"/>
                            <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="1">
                                <TextBox Text="{Binding ResolutionWidth}" Foreground="{DynamicResource TextBrush}" Background="Transparent" BorderThickness="0" Padding="8,6" FontSize="13"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="×" Foreground="{DynamicResource TextBrush}" Opacity="0.65" FontSize="20" VerticalAlignment="Bottom" Margin="12,0,12,6"/>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Alto (px)" Foreground="{DynamicResource TextBrush}" Opacity="0.65" FontSize="11" Margin="0,0,0,4"/>
                            <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="1">
                                <TextBox Text="{Binding ResolutionHeight}" Foreground="{DynamicResource TextBrush}" Background="Transparent" BorderThickness="0" Padding="8,6" FontSize="13"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                    
                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <CheckBox Content="Iniciar en pantalla completa" IsChecked="{Binding Fullscreen}" Foreground="{DynamicResource TextBrush}" Margin="0,0,25,10"/>
                        <CheckBox Content="Iniciar juego maximizado" IsChecked="{Binding MaximizeWindow}" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>
                    </WrapPanel>

                    <!-- JVM arguments, Wrapper & Launch Commands -->
                    <StackPanel>
                        <!-- JVM arguments & Wrapper -->
                        <TextBlock Text="Argumentos de la JVM adicionales" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="Bold" Margin="0,10,0,6"/>
                        <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="1" Margin="0,0,0,15">
                            <TextBox Text="{Binding JvmArgs}" Foreground="{DynamicResource TextBrush}" Background="Transparent" BorderThickness="0" Padding="8,6" Height="60" TextWrapping="Wrap" AcceptsReturn="True" FontSize="13"/>
                        </Border>

                        <TextBlock Text="Comando Wrapper (e.g. optirun, primusrun)" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="Bold" Margin="0,10,0,6"/>
                        <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="1" Margin="0,0,0,15">
                            <TextBox Text="{Binding WrapperCommand}" Foreground="{DynamicResource TextBrush}" Background="Transparent" BorderThickness="0" Padding="8,6" FontSize="13"/>
                        </Border>

                        <!-- Launch Commands -->
                        <TextBlock Text="Comandos de Lanzamiento" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="Bold" Margin="0,10,0,6"/>
                        
                        <TextBlock Text="Comando Pre-Lanzamiento" Foreground="{DynamicResource TextBrush}" Opacity="0.8" FontSize="12" Margin="0,5,0,4"/>
                        <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="1" Margin="0,0,0,15">
                            <TextBox Text="{Binding PreLaunchCommand}" Foreground="{DynamicResource TextBrush}" Background="Transparent" BorderThickness="0" Padding="8,6" FontSize="13"/>
                        </Border>

                        <TextBlock Text="Comando Post-Cierre" Foreground="{DynamicResource TextBrush}" Opacity="0.8" FontSize="12" Margin="0,5,0,4"/>
                        <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="1" Margin="0,0,0,15">
                            <TextBox Text="{Binding PostExitCommand}" Foreground="{DynamicResource TextBrush}" Background="Transparent" BorderThickness="0" Padding="8,6" FontSize="13"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Gestión de la Instancia -->
                <TextBlock Text="Gestión de la Instancia" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="Bold" Margin="0,15,0,8"/>
                <Border Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="15" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Estas opciones permiten limpiar los archivos de la instancia o eliminarla por completo de forma segura." Foreground="{DynamicResource TextBrush}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding FormatModpackCommand}" Style="{StaticResource PremiumButton}" Background="#FF8C00" Foreground="White" Padding="15,8" Margin="0,0,12,0" ToolTip="Limpia los mods y configuraciones pero mantiene la configuración base">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Broom" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Formatear Modpack" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding DeleteModpackCommand}" Style="{StaticResource PremiumButton}" Background="#AA3333" Foreground="White" Padding="15,8" ToolTip="Elimina físicamente todo el modpack y su listado">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="DeleteForever" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Borrar Modpack" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- Versión -->
        <DataTemplate DataType="{x:Type instance:VersionPageViewModel}">
            <StackPanel Margin="20">
                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextBrush}" Opacity="0.65" Margin="0,0,0,20"/>

                <TextBlock Text="Versión de Minecraft" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="Bold" Margin="0,10,0,6"/>
                <ComboBox ItemsSource="{Binding GameVersionsList}" SelectedItem="{Binding GameVersion}" Margin="0,0,0,15"/>

                <TextBlock Text="Cargador de Mods (Mod Loader)" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="Bold" Margin="0,10,0,6"/>
                <ComboBox ItemsSource="{Binding ModLoadersList}" SelectedItem="{Binding ModLoader}" Margin="0,0,0,15"/>

                <TextBlock Text="Versión del Cargador" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="Bold" Margin="0,10,0,6" IsEnabled="{Binding IsLoaderVersionEnabled}"/>
                <Border Background="{DynamicResource InputBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" CornerRadius="6" Padding="1" IsEnabled="{Binding IsLoaderVersionEnabled}">
                    <TextBox Text="{Binding LoaderVersion}" Foreground="{DynamicResource TextBrush}" Background="Transparent" BorderThickness="0" Padding="8,6" FontSize="13"/>
                </Border>
            </StackPanel>
        </DataTemplate>
        
        <!-- Mods -->
        <DataTemplate DataType="{x:Type instance:ModFolderPageViewModel}">
            <Grid Margin="20" Height="400">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="{Binding Description}" Foreground="{DynamicResource TextBrush}" Opacity="0.65" Margin="0,0,0,15" FontSize="13"/>
                
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                    <Button Command="{Binding OpenModsFolderCommand}" Style="{StaticResource PremiumButton}" Background="#3A3A3B" Foreground="{DynamicResource TextBrush}" Padding="15,8" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderOpenOutline" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Abrir carpeta de Mods" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RefreshModsCommand}" Style="{StaticResource PremiumButton}" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Foreground="{DynamicResource TextBrush}" Padding="15,8" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Refrescar" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding DeleteModCommand}" CommandParameter="{Binding SelectedMod}" Style="{StaticResource PremiumButton}" Background="#AA3333" Foreground="{DynamicResource TextBrush}" Padding="15,8" IsEnabled="{Binding IsDeleteAllowed}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Eliminar Mod" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Listado de Mods -->
                <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="5">
                    <ListBox ItemsSource="{Binding ModsList}" SelectedItem="{Binding SelectedMod}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="5" Width="550">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="PuzzleOutline" Width="20" Height="20" Foreground="{DynamicResource TextBrush}" Opacity="0.65" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" Foreground="{DynamicResource TextBrush}" Opacity="0.55" FontSize="11" VerticalAlignment="Center" Margin="10,0,5,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Packs de Recursos -->
        <DataTemplate DataType="{x:Type instance:ResourcePackPageViewModel}">
            <Grid Margin="20" Height="400">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="{Binding Description}" Foreground="{DynamicResource TextBrush}" Opacity="0.65" Margin="0,0,0,15" FontSize="13"/>
                
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                    <Button Command="{Binding OpenFolderCommand}" Style="{StaticResource PremiumButton}" Background="#3A3A3B" Foreground="{DynamicResource TextBrush}" Padding="15,8" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderOpenOutline" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Abrir carpeta de Packs" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RefreshCommand}" Style="{StaticResource PremiumButton}" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Foreground="{DynamicResource TextBrush}" Padding="15,8">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Refrescar" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="5">
                    <ListBox ItemsSource="{Binding ResourcePacksList}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="5" Width="550">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="{Binding IconKind}" Width="20" Height="20" Foreground="{DynamicResource TextBrush}" Opacity="0.65" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Opciones del Juego -->
        <DataTemplate DataType="{x:Type instance:GameOptionsPageViewModel}">
            <StackPanel Margin="20">
                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextBrush}" Opacity="0.65" Margin="0,0,0,20" FontSize="13"/>
                
                <!-- Solo visible con Modo Desarrollador habilitado -->
                <Border Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="20" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Archivo de Opciones (options.txt)" Foreground="{DynamicResource TextBrush}" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock Text="Puedes abrir y editar directamente el archivo options.txt en tu editor de texto predeterminado para modificar la configuración interna del juego como volumen, sensibilidad, controles, etc." Foreground="{DynamicResource TextBrush}" Opacity="0.65" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,20"/>
                        
                        <Button Command="{Binding OpenOptionsCommand}" Style="{StaticResource PremiumButton}" Background="#3C8527" Foreground="{DynamicResource TextBrush}" Padding="20,10" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileEditOutline" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Abrir options.txt" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Vista previa de options.txt (Siempre visible) -->
                <TextBlock Text="Contenido del archivo options.txt (Solo Lectura)" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="Bold" Margin="0,5,0,8"/>
                <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="5">
                    <TextBox Background="Transparent" Foreground="{DynamicResource TextBrush}" Opacity="0.8" BorderThickness="0" FontFamily="Consolas" FontSize="12"
                              Text="{Binding OptionsContent}" Height="280" IsReadOnly="True" AcceptsReturn="True" 
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- Registro de Consola -->
        <DataTemplate DataType="{x:Type instance:LogPageViewModel}">
            <StackPanel Margin="20">
                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextBrush}" Opacity="0.65" Margin="0,0,0,20" FontSize="13"/>
                <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="5">
                    <TextBox Background="Transparent" Foreground="{DynamicResource TextBrush}" Opacity="0.8" BorderThickness="0" FontFamily="Consolas" FontSize="12"
                              Text="{Binding LogContent}" Height="350" IsReadOnly="True" AcceptsReturn="True" 
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                </Border>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="CubeOutline" Width="30" Height="30" Foreground="{DynamicResource TextBrush}" Margin="0,0,15,0" VerticalAlignment="Center"/>
                <TextBlock Text="AJUSTES DE LA INSTANCIA" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/> <!-- Sidebar -->
                <ColumnDefinition Width="*"/>   <!-- Content -->
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" 
                         Background="Transparent" BorderThickness="0" Margin="0,10">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="5">
                                <materialDesign:PackIcon Kind="{Binding Icon}" Width="20" Height="20" Foreground="{DynamicResource TextBrush}" Opacity="0.8" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Content -->
            <Border Grid.Column="1" Background="{DynamicResource WindowBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Border Background="{DynamicResource PanelBrush}" Padding="20,10">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="{Binding SelectedPage.Icon}" Width="24" Height="24" Foreground="{DynamicResource TextBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding SelectedPage.DisplayName}" FontSize="18" Foreground="{DynamicResource TextBrush}" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ContentControl Content="{Binding SelectedPage}" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
