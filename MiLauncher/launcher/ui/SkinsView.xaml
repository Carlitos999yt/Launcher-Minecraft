<UserControl x:Class="MiLauncher.launcher.ui.SkinsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:utils="clr-namespace:MiLauncher.launcher.tools"
             xmlns:controls="clr-namespace:MiLauncher.Controls"
             Background="Transparent">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <utils:InvertedBooleanToVisibilityConverter x:Key="InvertedBoolToVis"/>
        <utils:InvertedBooleanConverter x:Key="InvertedBool"/>
        <utils:SkinToBodyConverter x:Key="SkinToBody"/>
        <utils:StringMatchToBooleanConverter x:Key="StringMatchToBool"/>
        <utils:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVis"/>
        <utils:NullOrEmptyToVisibilityInvertedConverter x:Key="NullOrEmptyToVisInverted"/>
    </UserControl.Resources>

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Visor oculto para la autogeneración secuencial de capturas en segundo plano (off-screen, 0 opacity) -->
        <controls:Skin3DViewer x:Name="HiddenPreviewGenerator" Grid.Row="1" Width="100" Height="200" Opacity="0" IsStatic="False" AllowAutoRender="False" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-400,0,0,0"/>
        
        <!-- Botón Volver -->
        <Button Command="{Binding GoBackCommand}" HorizontalAlignment="Left" Margin="0,0,0,20" Cursor="Hand" Background="Transparent" BorderThickness="0">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border" Background="#22FFFFFF" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="15,8">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ArrowLeft" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextBrush}" Width="18" Height="18"/>
                            <TextBlock Text="VOLVER AL MENÚ PRINCIPAL" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#33FFFFFF"/>
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
        
        <!-- VISTA DE BIBLIOTECA -->
        <Grid Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Hidden"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditing}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Izquierda: Skin Actual (Visor 3D animado interactivo) -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="Actual" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                <Border Width="160" Height="320" Background="Transparent" CornerRadius="8" Margin="0,0,0,20">
                    <controls:Skin3DViewer SkinPath="{Binding CurrentSkin.SkinPath}" CapePath="{Binding CurrentSkin.CapePath}" IsSlimModel="{Binding CurrentSkin.IsSlimModel}" IsStatic="False" Margin="10"/>
                </Border>
                <TextBlock Text="{Binding CurrentSkin.Name}" Foreground="{DynamicResource TextBrush}" Opacity="0.7" HorizontalAlignment="Center" FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Separador vertical -->
            <Border Grid.Column="1" Width="1" Background="{DynamicResource BorderBrush}" Margin="20,0"/>
            
            <!-- Derecha: Cuadrícula -->
            <StackPanel Grid.Column="2">
                <TextBlock Text="Biblioteca" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,20" HorizontalAlignment="Center"/>
                
                <WrapPanel>
                    <!-- Botón "+" Nuevo Aspecto -->
                    <Button Command="{Binding NewSkinCommand}" Width="140" Height="270" Margin="10" Cursor="Hand" Background="Transparent" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Border" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <materialDesign:PackIcon Kind="PlusCircleOutline" Width="36" Height="36" Foreground="#4CAF50" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="0"/>
                                        <TextBlock Text="Nuevo aspecto" TextWrapping="Wrap" TextAlignment="Center" FontSize="13" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Grid.Row="1" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#1AFFFFFF"/>
                                        <Setter TargetName="Border" Property="BorderBrush" Value="#4CAF50"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                        <!-- Lista de skins -->
                    <ItemsControl ItemsSource="{Binding SavedSkins}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="SkinCard" Width="140" Background="Transparent" CornerRadius="6" Margin="10">
                                    <StackPanel Margin="10">
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" TextTrimming="CharacterEllipsis"/>
                                        
                                        <Border Width="80" Height="160" Background="Transparent" HorizontalAlignment="Center" Margin="0,0,0,15" CornerRadius="4">
                                            <Grid>
                                                <!-- Carga la imagen de previsualización 3D estática directamente si existe -->
                                                <Image Source="{Binding PreviewPath}" Visibility="{Binding PreviewPath, Converter={StaticResource NullOrEmptyToVis}}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                                <!-- Si no hay previsualización estática, carga el renderizador 2D estático usando el converter -->
                                                <Image Source="{Binding Converter={StaticResource SkinToBody}}" Visibility="{Binding PreviewPath, Converter={StaticResource NullOrEmptyToVisInverted}}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                            </Grid>
                                        </Border>

                                        <!-- Botones de Acción (Lado a lado) -->
                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Botón Usar -->
                                            <Button Grid.Column="0" Command="{Binding DataContext.SelectSkinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" 
                                                    Height="35" Cursor="Hand" Background="Transparent" BorderThickness="0" Margin="0,0,6,0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Border" Background="#2E7D32" CornerRadius="6">
                                                            <TextBlock Text="USAR" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Border" Property="Background" Value="#388E3C"/>
                                                                <Setter TargetName="Border" Property="Effect">
                                                                    <Setter.Value>
                                                                        <DropShadowEffect Color="#4CAF50" BlurRadius="8" ShadowDepth="0" Opacity="0.6"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            
                                            <!-- Menú de opciones (tres puntos) -->
                                            <materialDesign:PopupBox Grid.Column="1" StaysOpen="False" PlacementMode="BottomAndAlignRightEdges" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                     PopupUniformCornerRadius="4">
                                                <materialDesign:PopupBox.ToggleContent>
                                                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Width="35" Height="35" CornerRadius="6" Cursor="Hand">
                                                        <materialDesign:PackIcon Kind="DotsHorizontal" Width="18" Height="18" Foreground="{DynamicResource TextBrush}" Opacity="0.65" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </materialDesign:PopupBox.ToggleContent>
                                                <StackPanel Width="150" Background="{DynamicResource PanelBrush}">
                                                    <Button Content="Editar" Foreground="{DynamicResource TextBrush}" Style="{DynamicResource MaterialDesignFlatButton}" HorizontalContentAlignment="Left"
                                                            Command="{Binding DataContext.EditExistingSkinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                    <Button Content="Duplicar" Foreground="{DynamicResource TextBrush}" Style="{DynamicResource MaterialDesignFlatButton}" HorizontalContentAlignment="Left"
                                                            Command="{Binding DataContext.DuplicateSkinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                    <Button Content="Borrar" Foreground="#FF5555" Style="{DynamicResource MaterialDesignFlatButton}" HorizontalContentAlignment="Left"
                                                            Command="{Binding DataContext.DeleteSkinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </materialDesign:PopupBox>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="SkinCard" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="SkinCard" Property="Background" Value="#33FFFFFF"/>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </WrapPanel>
            </StackPanel>
        </Grid>

        <!-- VISTA DE EDITOR -->
        <Grid Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Hidden"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Previsualización -->
            <StackPanel Grid.Column="0">
                <Border Width="160" Height="320" Background="Transparent" CornerRadius="8" Margin="0,40,0,0">
                    <controls:Skin3DViewer x:Name="Editor3DViewer" SkinPath="{Binding EditSkinPath}" CapePath="{Binding EditCapePath}" IsSlimModel="{Binding IsSlimModel}" Margin="10"/>
                </Border>
            </StackPanel>

            <!-- Formulario -->
            <StackPanel Grid.Column="1" Margin="40,0,0,0">
                <TextBlock Text="NOMBRE" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,5"/>
                <TextBox Text="{Binding EditName}" Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="#4CAF50" BorderThickness="1" Height="40" Padding="10" FontSize="14" Margin="0,0,0,20" Width="400" HorizontalAlignment="Left"/>
                
                <TextBlock Text="MODELO DE JUGADOR" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <RadioButton Content="Ancho" Foreground="{DynamicResource TextBrush}" IsChecked="{Binding IsSlimModel, Converter={StaticResource InvertedBool}}" Margin="0,0,20,0"/>
                    <RadioButton Content="Delgado" Foreground="{DynamicResource TextBrush}" IsChecked="{Binding IsSlimModel}"/>
                </StackPanel>

                <TextBlock Text="ARCHIVO DE ASPECTO" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,5"/>
                <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="1" SnapsToDevicePixels="True" Margin="0,0,0,20" Width="400" HorizontalAlignment="Left">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Mostrar solo el nombre del archivo, no la ruta completa -->
                        <TextBlock Text="{Binding EditSkinFileName}" Foreground="{DynamicResource TextBrush}" Padding="12,8" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis"/>
                        
                        <Border Grid.Column="1" Width="1" Background="{DynamicResource BorderBrush}" Margin="0,4"/>
                        <!-- Botón estético de carpeta -->
                        <Button Grid.Column="2" Command="{Binding BrowseSkinCommand}" Background="Transparent" BorderThickness="0" Width="40" Height="34" Padding="0" Cursor="Hand" ToolTip="Seleccionar Archivo de Skin">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder" Background="Transparent" CornerRadius="0,5,5,0">
                                        <materialDesign:PackIcon Kind="FolderOutline" Width="20" Height="20" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#33FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <TextBlock Text="CAPA" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>
                <!-- Selector visual de capas -->
                <!-- Selector visual de capas dinámico -->
                <ListBox ItemsSource="{Binding AvailableCapes}" 
                         SelectedValue="{Binding EditCapePath}" 
                         SelectedValuePath="Path"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         MaxHeight="300" Margin="0,0,0,30">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel IsItemsHost="True" Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,5,5">
                                <Border Width="40" Height="60" BorderBrush="#555555" BorderThickness="1" Background="{DynamicResource PanelBrush}">
                                    <Rectangle Width="40" Height="60" RenderOptions.BitmapScalingMode="NearestNeighbor">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Setter Property="Fill">
                                                    <Setter.Value>
                                                        <ImageBrush ImageSource="{Binding FullPath}" Viewbox="1,1,10,16" ViewboxUnits="Absolute" Stretch="Fill"/>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FullPath}" Value="{x:Null}">
                                                        <Setter Property="Fill" Value="Transparent" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>
                                </Border>
                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" Opacity="0.8" TextAlignment="Center" Margin="0,5,0,0" FontSize="10" FontWeight="SemiBold" Width="40" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Padding" Value="5"/>
                            <Setter Property="Margin" Value="0,0,5,5"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Name="Border" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#334CAF50"/>
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#4CAF50"/>
                                                <Setter TargetName="Border" Property="BorderThickness" Value="1"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#22FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <StackPanel Orientation="Horizontal">
                    <!-- GUARDAR Y APLICAR -->
                    <Button Command="{Binding SaveSkinCommand}" Width="160" Height="40" Margin="0,0,12,0" Cursor="Hand" Background="Transparent" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Border" Background="#4CAF50" CornerRadius="6">
                                    <TextBlock Text="GUARDAR Y APLICAR" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#43A047"/>
                                        <Setter TargetName="Border" Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#4CAF50" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                    <!-- CANCELAR -->
                    <Button Command="{Binding CancelEditCommand}" Width="100" Height="40" Cursor="Hand" Background="Transparent" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Border" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                    <TextBlock Text="CANCELAR" Foreground="{DynamicResource TextBrush}" Opacity="0.8" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#1AFFFFFF"/>
                                        <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource TextBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
