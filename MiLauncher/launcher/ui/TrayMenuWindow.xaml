<Window x:Class="MiLauncher.launcher.ui.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="TrayMenu" SizeToContent="Height" Width="180"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" Deactivated="Window_Deactivated">
    
    <Window.Resources>
        <Style x:Key="TrayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" Color="Black" Opacity="0.5" ShadowDepth="2"/>
        </Border.Effect>
        <StackPanel>
            <!-- Menú / Abrir -->
            <Button Click="Menu_Click" Style="{StaticResource TrayButtonStyle}" Foreground="White" HorizontalAlignment="Stretch" Padding="10,8" Height="Auto" Cursor="Hand">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="HomeOutline" Width="18" Height="18" Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Menú" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            
            <!-- Configuraciones -->
            <Button Click="Configuraciones_Click" Style="{StaticResource TrayButtonStyle}" Foreground="White" HorizontalAlignment="Stretch" Padding="10,8" Height="Auto" Cursor="Hand">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Tune" Width="18" Height="18" Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Ajustes" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            
            <!-- Skins -->
            <Button Click="Skins_Click" Style="{StaticResource TrayButtonStyle}" Foreground="White" HorizontalAlignment="Stretch" Padding="10,8" Height="Auto" Cursor="Hand">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="PaletteOutline" Width="18" Height="18" Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Skins" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            
            <!-- Forzar Cierre (Enabled only if game is running) -->
            <Button x:Name="BtnForceClose" Click="ForceClose_Click" Style="{StaticResource TrayButtonStyle}" Foreground="#FF5555" HorizontalAlignment="Stretch" Padding="10,8" Height="Auto" Cursor="Hand">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CloseOctagonOutline" Width="18" Height="18" Foreground="#FF5555" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Forzar Cierre" FontSize="13" Foreground="#FF5555" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            
            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="5,5"/>
            
            <!-- Cerrar Launcher -->
            <Button Click="CerrarLauncher_Click" Style="{StaticResource TrayButtonStyle}" Foreground="#FFAAAA" HorizontalAlignment="Stretch" Padding="10,8" Height="Auto" Cursor="Hand">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ExitToApp" Width="18" Height="18" Foreground="#FFAAAA" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Cerrar Launcher" FontSize="13" Foreground="#FFAAAA" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>
