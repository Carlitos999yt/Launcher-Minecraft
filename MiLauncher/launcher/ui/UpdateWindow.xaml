<Window x:Class="MiLauncher.launcher.ui.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Actualización Disponible" Height="420" Width="500"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource WindowBrush}" WindowStyle="None" AllowsTransparency="True"
        BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="{DynamicResource PanelBrush}" Padding="20,15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="ArrowUpBoldCircleOutline" Width="28" Height="28" Foreground="#4CAF50" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Text="¡ACTUALIZACIÓN DISPONIBLE!" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,15">
                <TextBlock x:Name="VersionText" Text="Versión Actual: 1.0.0  -->  Nueva Versión: 1.1.0" FontSize="14" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                <TextBlock Text="Novedades en esta versión:" FontSize="12" Foreground="{DynamicResource TextBrush}" Opacity="0.6" Margin="0,5,0,0"/>
            </StackPanel>

            <Border Grid.Row="1" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ChangelogText" Text="Cargando novedades..." Foreground="{DynamicResource TextBrush}" FontSize="13" TextWrapping="Wrap" LineHeight="20" FontFamily="Segoe UI"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Footer / Action Buttons -->
        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" Padding="20,15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="1" Click="Dismiss_Click" Style="{StaticResource PremiumButton}" Content="Recordar más tarde" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,10,0"/>
                <Button Grid.Column="2" Click="Update_Click" Style="{StaticResource PremiumButton}" Content="Actualizar Ahora" Background="#3C8527" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
            </Grid>
        </Border>
    </Grid>
</Window>
